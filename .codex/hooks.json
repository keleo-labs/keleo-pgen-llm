{
  "description": "Prompt-history hooks 1.0.1: resolve scripts from the Git project root.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|.*request_user_input.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/utils/prompt-history.py\" --hook tool",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/utils/prompt-history.py\" --hook user-prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
