# macOS
.DS_Store

# Generated practices (track directory structure, but you may want to review generated files)
# Uncomment the following lines if you don't want to track generated practice files:
practices/*
baselines/*
bundles/*

# Exception: Platform Adoption Essentials is the definitive baseline the
# library resolves against, not regenerable output, so it is tracked. Only
# the document itself — its phase reports and backups stay ignored.
!baselines/platform-adoption-essentials/
baselines/platform-adoption-essentials/*
!baselines/platform-adoption-essentials/platform-adoption-essentials.json
reviews/*
practice-resources/*
archive


.claude/settings.local.json
.claude/settings.json
.claude/user-config.json
.playwright-mcp/
__pycache__/
deps/*-cr.json
.tmp/*

# Deck projects scaffolded in-tree (decks are deliverables, not repo artifacts).
# The deck-foundation skill and its theme are tracked; built output is not.
node_modules/
decks/
**/build/
*.pptx

# Keep the practices directory structure
!practices/.gitkeep
!baselines/.gitkeep
!bundles/.gitkeep
!practice-resources/.gitkeep
