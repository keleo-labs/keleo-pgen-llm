# macOS
.DS_Store

# Generated practices (track directory structure, but you may want to review generated files)
# Uncomment the following lines if you don't want to track generated practice files:
practices/*
baselines/*
bundles/*

# Exception: Platform Adoption Essentials is the definitive baseline the
# library resolves against, not regenerable output, so it is tracked. Only
# the document itself — its phase reports and backups stay ignored.
!baselines/platform-adoption-essentials/
baselines/platform-adoption-essentials/*
!baselines/platform-adoption-essentials/platform-adoption-essentials.json
# backup-practice.py writes timestamped backups beside the documents it
# protects. Everywhere else that lands under an already-ignored tree, but
# deps/ is tracked, so without this a regeneration run would offer its own
# safety copies up for commit.
deps/backup-*/

reviews/*
practice-resources/*
archive

# Kept A/B eval workspaces from run-skill-eval.py. Preserved on purpose so a
# changed assertion can be re-scored offline with --rescore, but each one is a
# full copy of a generated practice and its inputs.
# Exception: what a run concluded, and why a run is not to be quoted, outlives
# the workspace it came from. Ignore the contents rather than the directory —
# git does not descend into an excluded directory, so a negation under `runs/`
# would never be reached.
runs/*
!runs/*/
runs/*/*
!runs/*/FINDING.md
!runs/*/benchmark.json


.claude/settings.local.json
.claude/settings.json
.claude/user-config.json
.playwright-mcp/
__pycache__/
deps/*-cr.json
.tmp/*

# Output of user-level skills that happen to run from this directory and write
# beside the project rather than into it. Not project material, and transcripts
# in particular carry third-party content this repository has no licence to
# republish.
transcripts/

# Deck projects scaffolded in-tree (decks are deliverables, not repo artifacts).
# The deck-foundation skill and its theme are tracked; built output is not.
node_modules/
decks/
**/build/
*.pptx

# Keep the practices directory structure
!practices/.gitkeep
!baselines/.gitkeep
!bundles/.gitkeep
!practice-resources/.gitkeep
