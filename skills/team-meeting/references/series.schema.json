{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keleo:team-meeting:series:1.1.0",
  "title": "Team meeting series 1.1.0",
  "type": "object",
  "required": ["version", "team", "objectives", "calendars", "history", "practice", "narratives", "review", "signals"],
  "additionalProperties": false,
  "properties": {
    "version": {"enum": ["1.0.0", "1.1.0"]},
    "team": {
      "type": "object", "required": ["name", "role", "members"], "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "role": {"$ref": "#/$defs/text"},
        "members": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["name", "email", "role", "responsibilities"], "additionalProperties": false,
          "properties": {"name": {"$ref": "#/$defs/text"}, "email": {"type": "string", "format": "email"}, "role": {"$ref": "#/$defs/text"}, "responsibilities": {"$ref": "#/$defs/texts"}}
        }}
      }
    },
    "objectives": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}]},
    "calendars": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "title", "timezone"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "timezone": {"$ref": "#/$defs/text"}}
    }},
    "history": {
      "type": "object", "required": ["paths", "lookbackMeetings"], "additionalProperties": false,
      "properties": {"paths": {"$ref": "#/$defs/texts"}, "lookbackMeetings": {"type": "integer", "minimum": 1}}
    },
    "practice": {
      "type": "object", "required": ["confirmed", "groups"], "additionalProperties": false,
      "properties": {"confirmed": {"type": "boolean"}, "groups": {"type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["name", "paths", "mergedPath"], "additionalProperties": false,
        "properties": {"name": {"$ref": "#/$defs/text"}, "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}, "mergedPath": {"$ref": "#/$defs/text"}}
      }}}
    },
    "narratives": {
      "type": "object", "required": ["summary", "retrospective", "news", "contributions", "confirmed"], "additionalProperties": false,
      "properties": {"summary": {"$ref": "#/$defs/text"}, "retrospective": {"$ref": "#/$defs/text"}, "news": {"$ref": "#/$defs/text"}, "contributions": {"$ref": "#/$defs/texts"}, "confirmed": {"type": "boolean"}}
    },
    "review": {
      "type": "object", "required": ["cadence", "recipes"], "additionalProperties": false,
      "properties": {"cadence": {"$ref": "#/$defs/text"}, "recipes": {"$ref": "#/$defs/texts"}, "relatedSeriesPaths": {"$ref": "#/$defs/texts"}, "focus": {"$ref": "#/$defs/texts"}, "requestReportId": {"$ref": "#/$defs/text"}, "metrics": {"type": "object", "properties": {"quotaAttainment": {"$ref": "#/$defs/quotaAttainment"}}}, "quarterOpening": {"type": "boolean"}, "sourceRosterDate": {"$ref": "#/$defs/text"}}
    },
    "signals": {"type": "array", "items": {"$ref": "signals.schema.json#/$defs/signal"}}
  },
  "$defs": {
    "quotaAttainment": {
      "title": "Team quota configuration 1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceSkill", "geography", "quotaViews", "metric", "currency", "currencyBasis", "period", "viewsAreAdditive", "retainProductBreakdown"],
      "properties": {
        "version": {"const": "1.0.0"},
        "sourceSkill": {"const": "product-quota-attainment"},
        "geography": {"$ref": "#/$defs/text"},
        "quotaViews": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "metric": {"enum": ["ACV+", "ARR"]},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "currencyBasis": {"enum": ["plan-rate", "reported"]},
        "period": {"const": "review-quarter"},
        "viewsAreAdditive": {"const": false},
        "retainProductBreakdown": {"const": true}
      }
    },
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  }
}
